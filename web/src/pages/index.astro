---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/ftx/Header.astro'
import Hero from '../components/ftx/Hero.astro'
import Marquee from '../components/ftx/Marquee.astro'
import Steps from '../components/ftx/Steps.astro'
import Showcase from '../components/ftx/Showcase.astro'
import Included from '../components/ftx/Included.astro'
import LeadForm from '../components/ftx/LeadForm.astro'
import Faq from '../components/ftx/Faq.astro'
import Packages from '../components/ftx/Packages.astro'
import Footer from '../components/ftx/Footer.astro'
import StickyCta from '../components/ftx/StickyCta.astro'
import HomeJsonLd from '../components/ftx/HomeJsonLd.astro'
import {getLocaleBlock} from '../data/content'
import {DEFAULT_LOCALE, type Locale} from '../lib/locale'
import {resolveSiteOrigin} from '../lib/site-url'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const meta = getLocaleBlock('meta', locale)
const siteOrigin = resolveSiteOrigin(Astro.site)
---

<BaseLayout title={meta.title} description={meta.description} variant="ftx">
  <HomeJsonLd slot="head" siteOrigin={siteOrigin} locale={locale} />
  <div class="ftx" id="top" style="font-family: 'Commissioner', 'Segoe UI', system-ui, sans-serif; color: #13232E">
    <Header />
    <main>
      <Hero />
      <Marquee />
      <Steps />
      <Showcase />
      <Included />
      <LeadForm />
      <Faq />
      <Packages />
    </main>
    <Footer />
    <StickyCta />
  </div>
</BaseLayout>
