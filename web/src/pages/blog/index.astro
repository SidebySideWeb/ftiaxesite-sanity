---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/ftx/Header.astro'
import Footer from '../../components/ftx/Footer.astro'
import {fetchHomePage, fetchPosts} from '../../lib/sanity'
import {imageUrl} from '../../lib/sanity'
import {DEFAULT_LOCALE, localizeHref, t, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const [home, posts] = await Promise.all([fetchHomePage(), fetchPosts()])
---

<BaseLayout title="Blog | ftiaxesite.gr">
  <div class="ftx" id="top">
    <Header />
    <main class="wrap page-main">
      <span class="eyebrow"><i><b></b><b></b></i>{t(home?.workEyebrow, locale) || 'Blog'}</span>
      <h1>Blog</h1>
      {home?.workIntro ? <p class="page-lead">{t(home.workIntro, locale)}</p> : null}
      {
        posts.length === 0 ? (
          <p>{locale === 'en' ? 'No posts yet.' : 'Δεν υπάρχουν άρθρα ακόμα.'}</p>
        ) : (
          <div class="page-grid">
            {posts.map((post) => {
              const slug = post.slug?.current ?? ''
              const image = imageUrl(post.mainImage, 640)
              return (
                <a class="page-card" href={localizeHref(`/blog/${slug}/`, locale)}>
                  {image ? <img src={image} alt="" loading="lazy" /> : null}
                  <div>
                    <h2>{t(post.title, locale)}</h2>
                    <p>{t(post.excerpt, locale)}</p>
                  </div>
                </a>
              )
            })}
          </div>
        )
      }
    </main>
    <Footer />
  </div>
</BaseLayout>
