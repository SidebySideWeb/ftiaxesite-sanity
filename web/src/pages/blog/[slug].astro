---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/ftx/Header.astro'
import Footer from '../../components/ftx/Footer.astro'
import {PortableText} from 'astro-portabletext'
import {fetchPostBySlug} from '../../lib/sanity'
import {DEFAULT_LOCALE, localizeHref, t, type Locale} from '../../lib/locale'

export const prerender = false

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const slug = Astro.params.slug ?? ''
const post = await fetchPostBySlug(slug)

if (!post) {
  return Astro.redirect(localizeHref('/404/', locale))
}

const body = (locale === 'en' ? post.body?.en : post.body?.el) ?? post.body?.el ?? post.body?.en ?? []
const seoTitle = t(post.seoTitle, locale) || t(post.title, locale)
const seoDescription = t(post.seoDescription, locale) || t(post.excerpt, locale)
---

<BaseLayout title={`${seoTitle} | ftiaxesite.gr`} description={seoDescription}>
  <div class="ftx" id="top">
    <Header />
    <main class="wrap page-main page-prose">
      <article>
        <h1>{t(post.title, locale)}</h1>
        {post.excerpt ? <p class="page-lead">{t(post.excerpt, locale)}</p> : null}
        <PortableText value={body} />
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
