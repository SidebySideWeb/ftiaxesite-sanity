---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/ftx/Header.astro'
import Footer from '../../components/ftx/Footer.astro'
import {fetchHomePage, fetchProjects, imageUrl} from '../../lib/sanity'
import {DEFAULT_LOCALE, t, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const [home, projects] = await Promise.all([fetchHomePage(), fetchProjects()])
const heading = t(home?.workHeading, locale)
---

<BaseLayout title={heading ? `${heading} | ftiaxesite.gr` : undefined}>
  <div class="ftx" id="top">
    <Header />
    <main class="wrap page-main">
      <span class="eyebrow"><i><b></b><b></b></i>{t(home?.workEyebrow, locale) || 'Portfolio'}</span>
      <h1>{heading || (locale === 'en' ? 'Work' : 'Έργα')}</h1>
      {home?.workIntro ? <p class="page-lead">{t(home.workIntro, locale)}</p> : null}
      <div class="page-grid">
        {
          projects.map((project) => {
            const image = imageUrl(project.screenshot, 640)
            const name = t(project.title, locale)
            return (
              <a
                class="page-card"
                href={project.liveUrl || '#'}
                target={project.liveUrl ? '_blank' : undefined}
                rel={project.liveUrl ? 'noopener noreferrer' : undefined}
              >
                {image ? <img src={image} alt="" loading="lazy" /> : null}
                <div>
                  <h2>{name}</h2>
                  {project.description ? <p>{t(project.description, locale)}</p> : null}
                </div>
              </a>
            )
          })
        }
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
