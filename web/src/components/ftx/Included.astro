---
import {PRICE_FROM} from '../../data/site'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE

const copy =
  locale === 'en'
    ? {
        eyebrow: 'THE 48 HOUR PACKAGE',
        title: 'What the price includes.',
        yesTitle: 'INCLUDED',
        noTitle: 'NOT INCLUDED',
        yes: [
          {label: 'Up to 5 sections', icon: 'layers'},
          {label: 'Looks right on mobile', icon: 'phone'},
          {label: 'Contact form', icon: 'mail'},
          {label: 'Google Map', icon: 'pin'},
          {label: 'Basic SEO', icon: 'search'},
          {label: 'SSL', icon: 'lock'},
        ],
        no: [
          {title: 'Texts and photos', note: 'You provide them.'},
          {title: 'Online store', note: 'Offered separately.'},
          {title: 'Special features', note: 'Offered separately.'},
        ],
        noFoot: 'Need one of these?',
        biggerLink: 'See the larger packages',
        yearlyBefore: 'Domain and hosting: ',
        yearlyAfter: '/year',
        yearlyTail: ', we write it up front.',
        yearlyTag: 'YEARLY COST',
        priceTag: 'FIXED PRICE · LIVE IN 48 HOURS',
        cta: 'I want this for my business',
      }
    : {
        eyebrow: 'ΤΟ ΠΑΚΕΤΟ 48 ΩΡΩΝ',
        title: 'Τι περιλαμβάνει η τιμή.',
        yesTitle: 'ΠΕΡΙΛΑΜΒΑΝΕΤΑΙ',
        noTitle: 'ΔΕΝ ΠΕΡΙΛΑΜΒΑΝΕΤΑΙ',
        yes: [
          {label: 'Έως 5 ενότητες', icon: 'layers'},
          {label: 'Σωστή εμφάνιση στο κινητό', icon: 'phone'},
          {label: 'Φόρμα επικοινωνίας', icon: 'mail'},
          {label: 'Χάρτης Google', icon: 'pin'},
          {label: 'Βασικό SEO', icon: 'search'},
          {label: 'SSL', icon: 'lock'},
        ],
        no: [
          {title: 'Κείμενα και φωτογραφίες', note: 'Τα φέρνεις εσύ.'},
          {title: 'Ηλεκτρονικό κατάστημα', note: 'Προσφέρεται ξεχωριστά.'},
          {title: 'Ειδικές λειτουργίες', note: 'Προσφέρονται ξεχωριστά.'},
        ],
        noFoot: 'Χρειάζεσαι κάτι από αυτά;',
        biggerLink: 'Δες τα μεγαλύτερα πακέτα',
        yearlyBefore: 'Domain και hosting: ',
        yearlyAfter: '/έτος',
        yearlyTail: ', το γράφουμε από την αρχή.',
        yearlyTag: 'ΕΤΗΣΙΟ ΚΟΣΤΟΣ',
        priceTag: 'ΣΤΑΘΕΡΗ ΤΙΜΗ · ΕΤΟΙΜΟ ΣΕ 48 ΩΡΕΣ',
        cta: 'Το θέλω για τη δουλειά μου',
      }

/** Odometer target: 490 (matches Main.html `.odo.n4` / `.n9` / `.n0`). */
const digits = (PRICE_FROM.replace(/\D/g, '').padStart(3, '0').slice(-3) || '490').split('') as [
  string,
  string,
  string,
]
const yearlyDisplay = '150 €'

const icons: Record<string, string> = {
  layers:
    '<path d="M12 3l9 5-9 5-9-5 9-5z"></path><path d="M3 13l9 5 9-5"></path>',
  phone:
    '<rect x="7" y="2.5" width="10" height="19" rx="2"></rect><path d="M11 18h2"></path>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>',
  search: '<circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>',
}
---

<section class="sec paper" id="paketo" data-component="Included">
  <div class="wrap">
    <div class="inc-hd">
      <div>
        <span class="eyebrow"><i><b></b><b></b></i>{copy.eyebrow}</span>
        <h2 class="rv-l">{copy.title}</h2>
      </div>
      <div class="price">
        <span class="sr">{PRICE_FROM}</span>
        <span class="big" aria-hidden="true">
          <span class={`odo n${digits[0]}`}>
            <span><b>0</b><b>1</b><b>2</b><b>3</b><b>4</b><b>5</b><b>6</b><b>7</b><b>8</b><b>9</b></span>
          </span>
          <span class={`odo n${digits[1]}`}>
            <span><b>0</b><b>1</b><b>2</b><b>3</b><b>4</b><b>5</b><b>6</b><b>7</b><b>8</b><b>9</b></span>
          </span>
          <span class={`odo n${digits[2]}`}>
            <span><b>0</b><b>1</b><b>2</b><b>3</b><b>4</b><b>5</b><b>6</b><b>7</b><b>8</b><b>9</b></span>
          </span>
          <span class="eur">€</span>
        </span>
        <span class="tag"><i></i>{copy.priceTag}</span>
      </div>
    </div>

    <div class="inc-grid">
      <div class="inc yes rv">
        <div class="inc-t">
          <span class="pill">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
            >
          </span>
          {copy.yesTitle}
        </div>
        <ul class="yes-list">
          {
            copy.yes.map((item) => (
              <li>
                <span class="ic">
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[item.icon]} />
                  <span class="ok">
                    <svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.2 2.2 4.8-4.8"></path></svg>
                  </span>
                </span>
                {item.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="inc no rv">
        <div class="inc-t">
          <span class="pill">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"></path></svg>
          </span>
          {copy.noTitle}
        </div>
        <ul class="no-list">
          {
            copy.no.map((item) => (
              <li>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"></path></svg>
                <span>
                  {item.title}
                  <small>{item.note}</small>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="no-foot">
          {copy.noFoot}{' '}
          <a href="#megalytera" id="link-bigger-packages">{copy.biggerLink}</a>
        </p>
      </div>
    </div>

    <div class="yearly rv-s" id="yearly-cost">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="15" rx="2"></rect>
        <path d="M3.5 10h17M8 3v4M16 3v4"></path>
      </svg>
      <p class="on-dark">
        {copy.yearlyBefore}<b><span class="ph">{yearlyDisplay}</span>{copy.yearlyAfter}</b
        >{copy.yearlyTail}
      </p>
      <span class="tagm">{copy.yearlyTag}</span>
    </div>

    <div class="sec-cta">
      <a class="btn btn-cta" href="#forma" id="cta-included" data-cta="included">
        {copy.cta}
        <span class="bars" aria-hidden="true"><b></b><b></b></span>
      </a>
    </div>
  </div>
</section>
