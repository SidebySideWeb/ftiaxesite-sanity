---
import {getLocaleBlock} from '../../data/content'
import {PHONE_TEL} from '../../data/site'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const header = getLocaleBlock('header', locale)
---

<div class="sticky-cta is-off" id="ftx-sticky-cta" data-component="StickyCta">
  <a class="btn btn-cta" href="#request" data-cta="sticky">{header.cta}</a>
  <a class="sc-tel" href={PHONE_TEL} data-cta="call-sticky" aria-label={header.callLabel}>
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg
    >
  </a>
</div>

<style>
  .sticky-cta.is-off {
    opacity: 0;
    pointer-events: none;
    transform: translateY(100%);
  }
  .sticky-cta.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(100%);
  }
</style>

<script>
  function initStickyCta() {
    const bar = document.getElementById('ftx-sticky-cta')
    if (!bar || bar.dataset.bound === 'true') return
    bar.dataset.bound = 'true'

    const requestSection = document.getElementById('request')

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop
      if (y >= 180) bar.classList.remove('is-off')
      else bar.classList.add('is-off')
    }

    window.addEventListener('scroll', onScroll, {passive: true})
    onScroll()

    if (requestSection && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((e) => e.isIntersecting)
          bar.classList.toggle('is-hidden', visible)
        },
        {root: null, threshold: 0.15},
      )
      io.observe(requestSection)
    }
  }

  initStickyCta()
  document.addEventListener('astro:page-load', initStickyCta)
</script>
