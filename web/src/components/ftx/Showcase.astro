---
import {getLocaleBlock} from '../../data/content'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const showcase = getLocaleBlock('showcase', locale, Astro.locals.homeContent)
const header = getLocaleBlock('header', locale, Astro.locals.homeContent)
const ctaSub = locale === 'en' ? 'Want your own?' : 'Θέλεις το δικό σου;'
const scrollHint = locale === 'en' ? 'SWIPE FOR MORE' : 'ΣΥΡΕ ΓΙΑ ΤΑ ΥΠΟΛΟΙΠΑ'
const projects = showcase.items
const fxClass = ['', 'v-villa', 'v-alu', 'v-club', 'v-shop'] as const
---

<section class="sec" id="deigmata" data-component="Showcase">
  <div class="wrap">
    <div class="sec-hd">
      <div>
        <span class="eyebrow"><i><b></b><b></b></i>{locale === 'en' ? 'SHOWCASE' : 'ΔΕΙΓΜΑΤΑ'}</span>
        <h2 class="rv-l">{showcase.title}.</h2>
      </div>
      <p>{showcase.sub}</p>
    </div>

    <div class="work">
      {
        projects.map((project, index) => (
          <article class:list={['wk', 'rv', {xl: project.xl}]} data-project={project.id}>
            <div class="wk-shot">
              <div class="bbar">
                <i></i>
                <i></i>
                <i></i>
                <span>{project.host}</span>
              </div>
              <div class="screen">
                <div class:list={['fx', fxClass[index] || '']}>
                  <div class="fx-nav">
                    <b></b>
                    <i></i>
                    <i></i>
                    <i></i>
                    {index === 0 ? <i></i> : null}
                  </div>
                  <div class="fx-hero">
                    <span class="fx-t">{project.name}</span>
                    <i></i>
                    <span class="fx-btn"></span>
                  </div>
                  {index === 0 || index === 3 ? (
                    <>
                      <div class="fx-lines">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-row">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-split">
                        <i></i>
                        <div>
                          <i></i>
                          <i></i>
                          <i></i>
                        </div>
                      </div>
                      {index === 0 ? (
                        <div class="fx-row">
                          <i></i>
                          <i></i>
                          <i></i>
                        </div>
                      ) : null}
                      <div class="fx-foot"></div>
                    </>
                  ) : index === 4 ? (
                    <>
                      <div class="fx-row">
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-row">
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-lines">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-foot"></div>
                    </>
                  ) : (
                    <>
                      <div class="fx-row">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      <div class="fx-lines">
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                      {index === 1 ? (
                        <div class="fx-split">
                          <i></i>
                          <div>
                            <i></i>
                            <i></i>
                            <i></i>
                          </div>
                        </div>
                      ) : (
                        <div class="fx-row">
                          <i></i>
                          <i></i>
                          <i></i>
                        </div>
                      )}
                      <div class="fx-foot"></div>
                    </>
                  )}
                </div>
                <span class="shot-tag">
                  {index === 0 ? `SCREENSHOT · ${project.host.toUpperCase()}` : 'SCREENSHOT'}
                </span>
              </div>
            </div>
            <div class="wk-meta">
              <div>
                <h3>{project.name}</h3>
                <span class="wk-type">{project.type}</span>
              </div>
              <a
                class="wk-link"
                href={project.url}
                target="_blank"
                rel="noopener"
                id={`showcase-${project.id}`}
                data-cta={`showcase-${project.id}`}
              >
                {showcase.open}{' '}
                <span class="c">
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <div class="wk-hint" aria-hidden="true">
      <i><b></b><b></b><b></b><b></b><b></b></i>
      {scrollHint}
    </div>

    <div class="sec-cta">
      <p>{ctaSub}</p>
      <a class="btn btn-cta" href="#forma" id="cta-showcase" data-cta="showcase">
        {header.cta} <span class="bars" aria-hidden="true"><b></b><b></b></span>
      </a>
    </div>
  </div>
</section>
