---
import {getLocaleBlock} from '../../data/content'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const marquee = getLocaleBlock('marquee', locale, Astro.locals.homeContent)
const repeat = (items: string[]) => [...items, ...items]
---

<div class="mq" aria-hidden="true">
  <div class="mq-band">
    <div class="mq-track">
      {repeat(marquee.bandA).map((label) => (
        <span>{label}</span>
      ))}
    </div>
  </div>
  <div class="mq-band alt">
    <div class="mq-track">
      {repeat(marquee.bandB).map((label) => (
        <span>{label}</span>
      ))}
    </div>
  </div>
</div>
<span class="sr">{marquee.sr}</span>
