---
import {getLocaleBlock} from '../../data/content'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const copy = getLocaleBlock('steps', locale, Astro.locals.homeContent)
---

<section class="sec paper" id="vimata" data-component="Steps">
  <div class="wrap">
    <div class="sec-hd">
      <div>
        <span class="eyebrow"><i><b></b><b></b></i>{copy.eyebrow}</span>
        <h2 class="rv-l">{copy.title}</h2>
      </div>
    </div>
    <ol class="steps">
      {
        copy.items.slice(0, 3).map((item, index) => (
          <li class="step rv">
            <div class="st-top">
              <span class="st-n">{String(index + 1).padStart(2, '0')}</span>
              <span class="st-time">{item.time}</span>
            </div>
            {item.ill === 'ill-prev' ? (
              <div class="ill ill-prev" aria-hidden="true">
                <div class="pw">
                  <span class="t"></span>
                  <span class="h"></span>
                  <span class="c">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                </div>
              </div>
            ) : item.ill === 'ill-live' ? (
              <div class="ill ill-live" aria-hidden="true">
                <span class="sw">
                  <b></b>
                  <span></span>
                </span>
                <span class="live-url">
                  <i></i>
                  {copy.liveUrl}
                </span>
              </div>
            ) : (
              <div class="ill ill-form" aria-hidden="true">
                <span class="r"></span>
                <span class="r"></span>
                <span class="r"></span>
                <span class="go"></span>
              </div>
            )}
            <h3>{item.title}</h3>
          </li>
        ))
      }
    </ol>

    <div class="tl" aria-hidden="true">
      <div class="tl-track"><span class="tl-fill"></span><span class="tl-dot"></span></div>
      <div class="tl-marks">
        {copy.marks.map((mark) => (
          <span>{mark}</span>
        ))}
      </div>
    </div>

    <div class="note rv-s" id="timer-note">
      <span class="ni">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="13" r="8"></circle>
          <path d="M12 9v4l2.5 2.5M9.5 2.5h5"></path>
        </svg>
      </span>
      <p>
        {copy.noteBefore}<b>{copy.noteBold}</b>
      </p>
    </div>

    <div class="sec-cta">
      <a class="btn btn-cta" href="#forma" id="cta-steps" data-cta="steps">
        {copy.cta}
        <svg class="ico arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>
