---
import {getLocaleBlock} from '../../data/content'
import {PHONE_DISPLAY, PHONE_TEL} from '../../data/site'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const faq = getLocaleBlock('faq', locale)
const header = getLocaleBlock('header', locale)

const eyebrow = locale === 'en' ? 'QUESTIONS' : 'ΕΡΩΤΗΣΕΙΣ'
const sideTitle = locale === 'en' ? 'Before you start.' : 'Πριν ξεκινήσεις.'
const sidePrompt = locale === 'en' ? 'Another question? Call us.' : 'Έχεις άλλη ερώτηση; Πάρε μας τηλέφωνο.'
---

<section class="sec" id="faq" data-component="Faq">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <div>
        <span class="eyebrow"><i><b></b><b></b></i>{eyebrow}</span>
        <h2>{sideTitle}</h2>
        <p class="faq-title-alt">{faq.title}</p>
      </div>
      <div class="ask">
        <p>{sidePrompt}</p>
        <a class="tel" href={PHONE_TEL} data-cta="call-faq">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
          </svg>
          <span class="ph">{PHONE_DISPLAY}</span>
        </a>
        <a class="btn btn-cta btn-sm" href="#request" data-cta="faq">{header.cta}</a>
      </div>
    </div>
    <div class="faq">
      {
        faq.items.map((item, index) => (
          <details open={index === 0} id={`faq-item-${index + 1}`}>
            <summary>
              <span class="q">
                <small>{String(index + 1).padStart(2, '0')}</small>
                {item.q}
              </span>
              <span class="pm" aria-hidden="true"></span>
            </summary>
            <p class="ans">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-title-alt {
    margin: 8px 0 0;
    color: var(--slate, #52616b);
    font-size: 1rem;
  }
</style>
