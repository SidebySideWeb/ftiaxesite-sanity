---
import {getLocaleBlock} from '../../data/content'
import {PHONE_DISPLAY, PHONE_TEL} from '../../data/site'
import {DEFAULT_LOCALE, type Locale} from '../../lib/locale'

const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const copy = getLocaleBlock('faq', locale, Astro.locals.homeContent)
const header = getLocaleBlock('header', locale, Astro.locals.homeContent)
---

<section class="sec" id="erotiseis" data-component="Faq">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <div>
        <span class="eyebrow"><i><b></b><b></b></i>{copy.eyebrow}</span>
        <h2>{copy.sideTitle}</h2>
      </div>
      <div class="ask">
        <p>{copy.sidePrompt}</p>
        <a class="tel" href={PHONE_TEL} id="tel-faq" data-cta="call-faq">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
          </svg>
          <span class="ph">{PHONE_DISPLAY}</span>
        </a>
        <a class="btn btn-cta btn-sm" href="#forma" id="cta-faq" data-cta="faq">{header.cta}</a>
      </div>
    </div>
    <div class="faq">
      {
        copy.items.map((item, index) => (
          <details open={index === 0} id={item.id}>
            <summary>
              <span class="q">
                <small>{String(index + 1).padStart(2, '0')}</small>
                {item.q}
              </span>
              <span class="pm" aria-hidden="true"></span>
            </summary>
            <p class="ans" set:html={item.a} />
          </details>
        ))
      }
    </div>
  </div>
</section>
