---
interface Props {
  readonly placement: 'head' | 'body'
}

const {placement} = Astro.props
const gtmId = (import.meta.env.PUBLIC_GTM_ID ?? '').trim()
---

{
  placement === 'head' && gtmId ? (
    <script is:inline define:vars={{gtmId}}>
      window.dataLayer = window.dataLayer || []
      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments)
        }
      // Consent Mode v2 defaults (EU): deny until the banner grants analytics.
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 1500,
      })

      if (!window.__ftiaxesiteGtmLoaded) {
        window.__ftiaxesiteGtmLoaded = true
        ;(function (w, d, s, l, i) {
          w[l] = w[l] || []
          w[l].push({'gtm.start': new Date().getTime(), event: 'gtm.js'})
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l !== 'dataLayer' ? '&l=' + l : ''
          j.async = true
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
          f.parentNode.insertBefore(j, f)
        })(window, document, 'script', 'dataLayer', gtmId)
      }

      window.__ftiaxesiteLoadGtm = function () {
        window.gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        })
      }
    </script>
  ) : null
}

{
  placement === 'body' && gtmId ? (
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        if (!window.__ftiaxesiteGtmLoaded) return
        window.dataLayer = window.dataLayer || []
        window.dataLayer.push({
          event: 'page_view',
          page_path: window.location.pathname,
          page_location: window.location.href,
          page_title: document.title,
        })
      })
    </script>
  ) : null
}
