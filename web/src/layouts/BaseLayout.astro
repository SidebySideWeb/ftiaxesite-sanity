---
import '@fontsource-variable/commissioner/wght.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/500.css'
import '@fontsource/jetbrains-mono/600.css'
import '../styles/ftx.css'
import '../styles/global.css'
import Analytics from '../components/Analytics.astro'
import CookieConsent from '../components/CookieConsent.astro'
import {buildCanonicalUrl, resolveSiteOrigin} from '../lib/site-url'
import {alternateLocalePath, DEFAULT_LOCALE, ogLocale, type Locale} from '../lib/locale'
import type {SiteSettingsDoc} from '../lib/types'

interface Props {
  title?: string
  description?: string
  settings?: SiteSettingsDoc | null
  noindex?: boolean
  /** ftx = lead-gen homepage design system */
  variant?: 'ftx' | 'legacy'
}

const {title, description, settings = null, noindex = false, variant = 'ftx'} = Astro.props
const locale: Locale = Astro.locals.locale ?? DEFAULT_LOCALE
const siteOrigin = resolveSiteOrigin(Astro.site)
const publicPath = Astro.locals.publicPath || Astro.url.pathname
const canonical = buildCanonicalUrl(publicPath, siteOrigin)
const alternateEl = buildCanonicalUrl(alternateLocalePath(publicPath, 'el'), siteOrigin)
const alternateEn = buildCanonicalUrl(alternateLocalePath(publicPath, 'en'), siteOrigin)

const pageTitle =
  title ??
  (locale === 'en'
    ? 'Website in 48 hours from €490 | ftiaxesite.gr'
    : 'Ιστοσελίδα σε 48 ώρες από 490 € | ftiaxesite.gr')
const pageDescription =
  description ??
  (locale === 'en'
    ? 'A professional website for small businesses, from €490. Send us your details and see your site online within 48 hours of receiving your material.'
    : 'Επαγγελματική ιστοσελίδα για μικρές επιχειρήσεις, από 490 €. Στείλε τα στοιχεία σου και δες το site σου online σε 48 ώρες από την παραλαβή του υλικού.')
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={alternateEl} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEl} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(locale === 'en' ? 'el' : 'en')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ftiaxesite.gr" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/ftiaxesite-favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
      if (window.trustedTypes && window.trustedTypes.createPolicy && !window.trustedTypes.defaultPolicy) {
        window.trustedTypes.createPolicy('default', {
          createHTML: function (s) {
            return s
          },
          createScript: function (s) {
            return s
          },
          createScriptURL: function (s) {
            return s
          },
        })
      }
    </script>
    <Analytics placement="head" />
    <slot name="head" />
  </head>
  <body class={variant === 'ftx' ? 'ftx-body' : undefined}>
    <Analytics placement="body" />
    <slot />
    <CookieConsent />
    <script is:inline>
      try {
        localStorage.setItem('ftiaxesite-lang', document.documentElement.lang === 'en' ? 'en' : 'el')
      } catch (e) {}

      // Fallback for browsers without scroll-driven animations
      if (!CSS.supports('animation-timeline', 'view()')) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in')
                io.unobserve(entry.target)
              }
            })
          },
          {threshold: 0.12},
        )
        function initReveal() {
          document.querySelectorAll('.rv, .rv-l, .rv-s, .tl, .price, .reveal').forEach(function (el) {
            io.observe(el)
          })
        }
        initReveal()
        document.addEventListener('astro:page-load', initReveal)
      }
    </script>
  </body>
</html>

<style is:global>
  .ftx-body {
    margin: 0;
    background: var(--paper, #f4f6f3);
  }
</style>
